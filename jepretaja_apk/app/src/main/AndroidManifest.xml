<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dibutuhkan ConnectivityObserver untuk mengetahui saat internet putus,
         supaya aplikasi bisa memberi tahu alih-alih menampilkan layar kosong
         yang terbaca seperti kerusakan. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Rekaman video dalam aplikasi ikut merekam suara. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Hanya untuk menyimpan slip pembayaran ke galeri di Android 9 ke bawah,
         yang belum punya scoped storage. Sejak Android 10 MediaStore menulis
         tanpa izin apa pun, jadi izinnya sengaja dibatasi maxSdkVersion="28" —
         meminta izin penyimpanan penuh di perangkat baru tidak ada gunanya dan
         hanya membuat aplikasi terlihat lebih rakus daripada seharusnya. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".JepretAjaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.JepretAja"
        android:usesCleartextTraffic="false">

        <!-- Dibutuhkan agar aplikasi kamera bawaan bisa menulis hasil jepretan ke
             berkas milik JepretAja. Sejak Android 7 melempar Uri file:// antar
             aplikasi memicu FileUriExposedException, jadi hasil rekaman harus
             lewat content:// milik provider ini. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JepretAja.Splash"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="TODO_ISI_GOOGLE_MAPS_API_KEY" />

        <service
            android:name=".core.util.JepretAjaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
