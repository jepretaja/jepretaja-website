<?xml version="1.0" encoding="utf-8"?>
<!--
  Overlay manifest khusus build debug.

  Hanya menambahkan network security config supaya APK debug boleh menghubungi
  dev server di laptop lewat http://. Manifest utama tidak diubah, jadi build
  release tetap memakai usesCleartextTraffic="false" apa adanya.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
