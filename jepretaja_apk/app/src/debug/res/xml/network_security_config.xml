<?xml version="1.0" encoding="utf-8"?>
<!--
  Izin HTTP polos KHUSUS build debug, untuk menembak dev server di laptop.

  Manifest utama menyetel android:usesCleartextTraffic="false" — itu benar dan
  sengaja: aplikasi produksi hanya boleh bicara lewat HTTPS. Tapi Vite dev
  server berjalan di http:// biasa, jadi tanpa berkas ini APK debug menolak
  semua permintaan ke laptop dan gagal dengan error koneksi yang membingungkan
  (bukan pesan "ditolak karena HTTP", melainkan kegagalan jaringan biasa).

  Berkas ini ada di sourceSet `debug`, jadi TIDAK ikut ke APK release —
  build produksi tetap HTTPS-only tanpa pengecualian apa pun.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- IP laptop di jaringan Wi-Fi — dipakai HP fisik yang sejaringan. -->
        <domain includeSubdomains="false">10.191.206.86</domain>
        <!-- Alamat khusus emulator Android untuk menunjuk localhost laptop. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
