# ============================================================
# Salin file ini menjadi ".env" untuk development lokal.
# Untuk produksi, isi nilai yang sama di:
# Vercel > Project > Settings > Environment Variables
# ============================================================

# --- Firebase Web App config ---
# Firebase Console > Project Settings > Your apps > Web app
# Nilai-nilai ini AMAN terlihat publik di browser (memang dirancang begitu);
# yang melindungi data adalah firestore.rules, bukan kerahasiaan key ini.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Cloudinary unsigned upload untuk foto dan video creator.
# Dashboard > Settings > Upload > Upload presets > Signing Mode: Unsigned.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Opsional ---
# reCAPTCHA v3 site key. Kosongkan saja kalau App Check belum diaktifkan;
# web tetap berfungsi penuh tanpa ini.
VITE_RECAPTCHA_SITE_KEY=

# Kosongkan kalau API dideploy bareng web ini (kondisi normal di Vercel).
VITE_ADMIN_API_BASE=

# ============================================================
# HANYA UNTUK SERVER — JANGAN diawali VITE_ (kalau diawali VITE_
# nilainya ikut terbundel ke browser dan bocor ke publik).
# ============================================================

# Isi seluruh file service account JSON dari:
# Firebase Console > Project Settings > Service accounts > Generate new private key
# Boleh ditempel apa adanya (JSON) atau versi base64-nya.
FIREBASE_SERVICE_ACCOUNT=

# --- Midtrans (SERVER ONLY, jangan diawali VITE_) ---
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
APP_PUBLIC_URL=https://jepretaja-website-jepretaja.vercel.app
