<?xml version="1.0" encoding="utf-8"?>
<!--
  Aturan cadangan & transfer perangkat (Android 12+).

  Yang dikecualikan adalah berkas yang menyimpan SESI dan identitas perangkat.
  Tanpa pengecualian ini, sesi login bisa ikut tersalin ke perangkat lain lewat
  cadangan Google — pengguna baru pada perangkat baru bisa mendapati dirinya
  sudah masuk sebagai akun orang lain. Preferensi aplikasi sendiri (penanda
  onboarding/tamu) tidak berbahaya dan tetap ikut dicadangkan.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.measurement.prefs.xml" />
        <exclude domain="file" path="PersistedInstallation" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="com.google.firebase.auth.api.Store.xml" />
        <exclude domain="sharedpref" path="com.google.android.gms.appid.xml" />
        <exclude domain="file" path="PersistedInstallation" />
    </device-transfer>
</data-extraction-rules>
